# Copy to .env and edit. Every value here has a dev-safe default except
# STYLESIGNAL_ANTHROPIC_API_KEY and STYLESIGNAL_JWT_SECRET.

# --- Core ----------------------------------------------------------------
STYLESIGNAL_ENV=dev
STYLESIGNAL_JWT_SECRET=change-me-to-32-plus-random-bytes-in-any-real-deployment
STYLESIGNAL_ACCESS_TOKEN_TTL_MINUTES=30
STYLESIGNAL_REFRESH_TOKEN_TTL_DAYS=30

# --- Database ------------------------------------------------------------
# dev default is SQLite in ./var/stylesignal.db
# production: postgresql+psycopg://user:pass@host:5432/stylesignal
STYLESIGNAL_DATABASE_URL=sqlite:///./var/stylesignal.db

# --- Object storage (§4.9, §5.7) -----------------------------------------
# local | s3
STYLESIGNAL_STORAGE_BACKEND=local
STYLESIGNAL_LOCAL_STORAGE_DIR=./var/objects
# S3 only:
STYLESIGNAL_S3_BUCKET=
STYLESIGNAL_S3_REGION=
STYLESIGNAL_S3_ENDPOINT_URL=
STYLESIGNAL_S3_SSE=AES256

# --- Job queue (§4.2) ----------------------------------------------------
# inprocess | arq
STYLESIGNAL_QUEUE_BACKEND=inprocess
STYLESIGNAL_REDIS_URL=redis://localhost:6379/0
STYLESIGNAL_INPROCESS_CONCURRENCY=2

# --- Rate limiting (§8) ----------------------------------------------------
# inprocess | redis (uses STYLESIGNAL_REDIS_URL above). inprocess under-counts
# once you run more than one gateway worker.
STYLESIGNAL_RATELIMIT_BACKEND=inprocess

# --- VLM (§4.7, §7.5) ----------------------------------------------------
STYLESIGNAL_ANTHROPIC_API_KEY=
STYLESIGNAL_VLM_MODEL=claude-opus-5
STYLESIGNAL_VLM_EFFORT=medium
STYLESIGNAL_VLM_MAX_TOKENS=8000
# Max lint-and-regenerate attempts before falling back to templated text (§7.6)
STYLESIGNAL_VLM_MAX_LINT_RETRIES=2
# Set true to skip the VLM entirely and always use the templated fallback.
# Useful for local UI work without burning tokens.
STYLESIGNAL_VLM_DISABLED=false

# --- Quotas / cost control (§1, §8) --------------------------------------
# Temporarily raised for a device-testing pass (docs/spec-deviations.md #17);
# drop back to a real pricing number before shipping.
STYLESIGNAL_FREE_MONTHLY_SCANS=50
STYLESIGNAL_SCANS_EARNED_PER_RATING=1
STYLESIGNAL_RATINGS_PER_EARNED_SCAN=3
# Soft fair-use ceiling for Pro. Not advertised; degrades rather than blocks.
STYLESIGNAL_PRO_SOFT_MONTHLY_CAP=300
STYLESIGNAL_MAX_UPLOAD_BYTES=12000000
STYLESIGNAL_MAX_LONGEST_EDGE=1600

# --- Community rating loop (§6.5) -----------------------------------------
# Off by default: §9 defers the feed/rating endpoints to v2. Flipping this
# on also activates the §1 earn-by-rating free-tier hook.
STYLESIGNAL_COMMUNITY_ENABLED=false

# --- Native in-app purchases (SPEC+, docs/spec-deviations.md #18) ---------
# Product ids must match what's created in App Store Connect / Play Console.
STYLESIGNAL_PRO_MONTHLY_PRICE_USD=4.99
STYLESIGNAL_IAP_PRODUCT_ID_IOS=stylesignal_pro_monthly
STYLESIGNAL_IAP_PRODUCT_ID_ANDROID=stylesignal_pro_monthly
# App Store Connect -> your app -> App Information -> App-Specific Shared Secret.
STYLESIGNAL_APPLE_SHARED_SECRET=
# Play Console package name, and a Google Cloud service account (Play
# Developer API access to this app) exported as JSON, as one env value.
STYLESIGNAL_GOOGLE_PLAY_PACKAGE_NAME=
STYLESIGNAL_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Outbound email (SPEC+ — password reset) ------------------------------
# console | resend. console just logs the reset code; resend sends a real
# email via https://resend.com. Get the API key from the Resend dashboard.
STYLESIGNAL_EMAIL_BACKEND=console
STYLESIGNAL_RESEND_API_KEY=
# onboarding@resend.dev works with no setup but only delivers to the
# account's own verified email — point this at a verified sending domain
# (Resend dashboard -> Domains) before it needs to reach real users.
STYLESIGNAL_EMAIL_FROM=StyleSignal <onboarding@resend.dev>
